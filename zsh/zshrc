autoload -Uz compinit vcs_info
compinit

HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt APPEND_HISTORY SHARE_HISTORY HIST_IGNORE_DUPS PROMPT_SUBST

alias vim=nvim

zstyle ':vcs_info:git:*' formats ' %F{yellow}(%b)%f'
zstyle ':vcs_info:git:*' actionformats ' %F{yellow}(%b|%a)%f'

precmd() {
  vcs_info
}

PROMPT='%F{cyan}%2~%f${vcs_info_msg_0_} %F{blue}❯%f '
